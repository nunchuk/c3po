# Copy to .env and fill in real values. .env is gitignored.

# Bedrock API key (bearer token). The Anthropic SDK reads this automatically.
# Get it from the AWS Bedrock console (API keys), NOT a full AWS access key.
AWS_BEARER_TOKEN_BEDROCK=

# Bedrock region. Tokyo by default: both default model ids (c3po/config.py) are
# "jp." inference profiles, which only serve the Japan regions. Set
# C3PO_AWS_REGION rather than AWS_REGION -- a shell-level AWS_REGION silently
# overrides this file.
C3PO_AWS_REGION=ap-northeast-1
