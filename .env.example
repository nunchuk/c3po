# Copy to .env and fill in real values. .env is gitignored.

# Bedrock API key (bearer token). The Anthropic SDK reads this automatically.
# Get it from the AWS Bedrock console (API keys), NOT a full AWS access key.
AWS_BEARER_TOKEN_BEDROCK=

# AWS region for Bedrock. Tokyo by default.
# NOTE: Claude Haiku 4.5 has no jp/apac regional inference profile, so use the
# "global." model id (set in config) which routes dynamically. If Tokyo cannot
# reach it, fall back to us-east-1.
AWS_REGION=ap-northeast-1
